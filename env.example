# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-uma-chave-secreta-com-openssl-rand-base64-32

# Vercel Postgres Database
# Estas variáveis são geradas automaticamente pela Vercel
# Vá em: Dashboard > Storage > Create Database > Postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Base URL para QR Codes
# Produção: https://escovato.com.br
# Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cron Job Secret (para fechamento automático do rodízio)
# Gere com: openssl rand -base64 32
CRON_SECRET=gere-uma-chave-secreta-para-o-cron

